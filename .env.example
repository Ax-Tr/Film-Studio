# Copy to .env. Supply values locally; never commit populated secrets.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=3000

POSTGRES_DB=film_studio
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

REDIS_URL=redis://127.0.0.1:6379

OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=local
OBJECT_STORAGE_BUCKET=film-studio-dev
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Space-separated origins. Production values are deployment configuration.
ALLOWED_ORIGINS=http://127.0.0.1:3000

# Required in staging/production. Values come from the approved OIDC tenant.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_WEB_REDIRECT_URI=
OIDC_ANDROID_REDIRECT_URI=
OIDC_IOS_REDIRECT_URI=
WEB_APP_URL=http://127.0.0.1:3000
# Generate 32 random bytes and encode them as unpadded base64url.
AUTH_TRANSACTION_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=false
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000
