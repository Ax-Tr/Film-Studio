FROM node:24-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS builder
WORKDIR /app

# Copy dependency configuration
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
COPY tsconfig*.json ./

# Copy required workspaces for frontend
COPY packages ./packages
COPY frontend ./frontend

# Install dependencies and build frontend
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @film-studio/screenplay-model build && \
    pnpm --filter @film-studio/contracts build && \
    pnpm --filter @film-studio/domain build && \
    pnpm --filter @film-studio/editor-bridge build && \
    pnpm --filter @film-studio/localization build && \
    pnpm --filter @film-studio/design-tokens build && \
    pnpm --filter @film-studio/auth-client build && \
    pnpm --filter @film-studio/api-client build && \
    pnpm --filter @film-studio/sync-core build && \
    pnpm --filter @film-studio/pagination build && \
    pnpm --filter @film-studio/web build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Copy Next.js standalone build and static assets
COPY --from=builder /app/frontend/.next/standalone ./
COPY --from=builder /app/frontend/.next/static ./frontend/.next/static
COPY --from=builder /app/frontend/public ./frontend/public

EXPOSE 3000

# Health check probe
HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 3000) + '/').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

CMD ["node", "frontend/server.js"]
