FROM node:24-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS builder
WORKDIR /app

# Copy dependency configuration
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
COPY tsconfig*.json ./
# Copy required workspaces
COPY packages ./packages
COPY workers ./workers
COPY backend ./backend
COPY infra ./infra

# Install dependencies and build
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @film-studio/screenplay-model build && \
    pnpm --filter @film-studio/contracts build && \
    pnpm --filter @film-studio/domain build && \
    pnpm --filter @film-studio/sync-core build && \
    pnpm --filter @film-studio/pagination build && \
    pnpm --filter @film-studio/jobs build && \
    pnpm --filter @film-studio/api build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000
ENV HOST=0.0.0.0

# Copy full built workspace for runtime execution and migration runner
COPY --from=builder /app /app

EXPOSE 4000

# Health check probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 4000) + '/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

CMD ["node", "backend/dist/main.js"]
