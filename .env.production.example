# ==============================================================================
# Film Studio Platform - Production Environment Configuration
# Tailored for Free Hosting on Supabase + Upstash + Railway / Render
# ==============================================================================

# Application Environment
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=3000

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database (Free Tier)
# ------------------------------------------------------------------------------
# Direct URL or Transaction Pooler URL from Supabase Project Settings -> Database:
# postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://postgres.example-ref:super-secure-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ------------------------------------------------------------------------------
# 2. Upstash Redis (Free Tier)
# ------------------------------------------------------------------------------
# TLS-enabled connection string from Upstash Console (https://console.upstash.com)
REDIS_URL=rediss://default:example-redis-password@global-redis.upstash.io:6379

# ------------------------------------------------------------------------------
# 3. Supabase S3-Compatible Object Storage
# ------------------------------------------------------------------------------
# S3 Credentials from Supabase Settings -> Storage -> S3 Access Keys
OBJECT_STORAGE_ENDPOINT=https://example-ref.supabase.co/storage/v1/s3
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=film-studio-assets
OBJECT_STORAGE_ACCESS_KEY=example-s3-access-key
OBJECT_STORAGE_SECRET_KEY=example-s3-secret-key-at-least-16-chars-long

# ------------------------------------------------------------------------------
# 4. Networking, Ingress & CORS
# ------------------------------------------------------------------------------
# Space-separated list of origins permitted to call the API
ALLOWED_ORIGINS=https://film-studio-web.onrender.com https://film-studio-web.up.railway.app
WEB_APP_URL=https://film-studio-web.onrender.com

# ------------------------------------------------------------------------------
# 5. OIDC Identity Provider (Google OAuth / Auth0 / Microsoft Entra)
# ------------------------------------------------------------------------------
# Obtain client credentials from Google Cloud Console (APIs & Services -> Credentials)
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=example-oauth-client-id.apps.googleusercontent.com
OIDC_CLIENT_SECRET=example-oauth-client-secret-min-16-chars
OIDC_WEB_REDIRECT_URI=https://film-studio-web.onrender.com/auth/complete
OIDC_ANDROID_REDIRECT_URI=filmstudio://auth/callback
OIDC_IOS_REDIRECT_URI=filmstudio://auth/callback

# ------------------------------------------------------------------------------
# 6. Session & Encryption Security
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_TRANSACTION_ENCRYPTION_KEY=AAzBoFOW17r88qwg9-w-HbAfv9mQrpcdYN_JuN7xSgM
SESSION_COOKIE_SECURE=true
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000
