{
  "name": "film-studio-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Production foundation for the Film Studio web, mobile, API and worker applications.",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "10.20.0"
  },
  "scripts": {
    "boundaries:check": "node scripts/verify-boundaries.mjs",
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "check": "pnpm boundaries:check && pnpm secrets:check && pnpm config:check && pnpm lint && pnpm build && pnpm typecheck && pnpm db:test:migration && pnpm db:test:canonical && pnpm db:test:sync && pnpm db:test:jobs && pnpm db:test:web && pnpm test:editor && pnpm test:sync:center && pnpm db:test:characters && pnpm db:test:revisions && pnpm db:test:story && pnpm db:test:intelligence && pnpm db:test:continuity && pnpm db:test:aigateway && pnpm db:test:aiproposal && pnpm db:test:aifilmdev && pnpm db:test:breakdown && pnpm db:test:scheduling && pnpm db:test:budget && pnpm db:test:collab && pnpm db:test:admin && pnpm db:test:quotas && pnpm db:test:knowledge && pnpm db:test:interop && pnpm test:qualification && pnpm test:launch && pnpm db:test:webrc && pnpm db:test:mobile && pnpm db:test:mobile:editor && pnpm db:test:mobile:sync && pnpm db:test:androidrc && pnpm test:ios && pnpm test:ios:editor && pnpm test:ios:sync && pnpm test:iosrc && pnpm test",
    "clean": "turbo run clean",
    "config:check": "node scripts/validate-config.mjs",
    "db:migrate": "pnpm --filter @film-studio/api db:migrate",
    "dev": "turbo run dev --parallel",
    "db:test:migration": "tsx scripts/test-identity-migration.ts",
    "db:test:canonical": "tsx scripts/test-canonical-model.ts",
    "db:test:sync": "tsx scripts/test-sync-protocol.ts",
    "db:test:jobs": "tsx scripts/test-files-and-jobs.ts",
    "db:test:web": "tsx scripts/test-web-project-workflows.ts",
    "db:test:characters": "tsx scripts/test-characters-scenes-search.ts",
    "db:test:revisions": "tsx scripts/test-revisions-import-export.ts",
    "db:test:webrc": "tsx scripts/test-web-release-candidate.ts",
    "db:test:mobile": "tsx scripts/test-mobile-android-shell.ts",
    "db:test:mobile:editor": "tsx scripts/test-mobile-editor-durability.ts",
    "db:test:mobile:sync": "tsx scripts/test-mobile-sync-export.ts",
    "db:test:androidrc": "tsx scripts/test-android-release-candidate.ts",
    "test:ios": "tsx scripts/test-ios-platform-integration.ts",
    "test:ios:editor": "tsx scripts/test-ios-editor-durability.ts",
    "test:ios:sync": "tsx scripts/test-ios-sync-export.ts",
    "test:iosrc": "tsx scripts/test-ios-release-candidate.ts",
    "db:test:story": "tsx scripts/test-story-development.ts",
    "db:test:intelligence": "tsx scripts/test-intelligence-sequences.ts",
    "db:test:continuity": "tsx scripts/test-continuity-revisions.ts",
    "db:test:aigateway": "tsx scripts/test-ai-provider-gateway.ts",
    "db:test:aiproposal": "tsx scripts/test-ai-proposal-workflow.ts",
    "db:test:aifilmdev": "tsx scripts/test-ai-film-development.ts",
    "db:test:breakdown": "tsx scripts/test-production-breakdown.ts",
    "db:test:scheduling": "tsx scripts/test-scheduling-stripboard.ts",
    "db:test:budget": "tsx scripts/test-budget-reporting.ts",
    "db:test:collab": "tsx scripts/test-multi-user-collaboration.ts",
    "db:test:admin": "tsx scripts/test-film-administration-approvals.ts",
    "db:test:quotas": "tsx scripts/test-enterprise-quotas.ts",
    "db:test:knowledge": "tsx scripts/test-knowledge-multilingual-search.ts",
    "db:test:interop": "tsx scripts/test-portfolio-interop-extensions.ts",
    "test:qualification": "tsx scripts/test-system-hardening-qualification.ts",
    "test:launch": "tsx scripts/test-production-launch-stabilization.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:config": "docker compose --env-file .env -f infra/docker/compose.yaml config --quiet",
    "infra:down": "docker compose --env-file .env -f infra/docker/compose.yaml down",
    "infra:up": "docker compose --env-file .env -f infra/docker/compose.yaml up -d --wait",
    "lint": "eslint frontend backend android ios packages workers scripts --max-warnings=0",
    "secrets:check": "node scripts/scan-secrets.mjs",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "test:contract": "pnpm --filter @film-studio/contracts test",
    "test:editor": "tsx scripts/test-screenplay-editor.ts",
    "test:sync:center": "tsx scripts/test-web-sync-center.ts",
    "typecheck": "pnpm --filter @film-studio/screenplay-model build && pnpm --filter @film-studio/contracts build && pnpm --filter @film-studio/domain build && pnpm -r --workspace-concurrency=1 --if-present run typecheck"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "10.14.0",
    "globals": "16.5.0",
    "pg": "8.23.1",
    "pg-gateway": "0.3.0-beta.4",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}